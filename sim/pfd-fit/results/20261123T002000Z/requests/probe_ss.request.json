{
  "_comment": [
    "sg13g2-dll sim/pfd-fit probe (probe_ss): single-corner diagnostic for issue #151 -",
    "probe-vs-gate reconciliation after the srlatch_buf rewire (spec/decisions/0015). Probes the",
    "PFD-internal nodes of the committed pfd (set_up/set_dn/reset plus the latch-facing",
    "up_qn/up_qb/dn_qn/dn_qb) alongside ref/fb/up/dn at ss/1.08 V/125 C only. DUT is the committed",
    "design/netlist/pfd.spice subckt pfd itself (deck stimulus byte-identical to",
    "sim/pfd-fit/decks/pfd_1g.spice, same 4 fF bench loads). Compare against the retained unwired",
    "candidate probe sim/pfd-fit/results/20261116T012100Z (path 30.8 / release 174.4 / width 205.2 ps).",
    "Run locally through `klt sim` (single unit, --backend local). Simulated, never measured."
  ],
  "engine": "ngspice",
  "netlist": "../decks/probe_ss.spice",
  "netlist_source": "schematic",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerMOSlv.lib"
  },
  "corners": {
    "units": [
      {
        "process": "mos_ss",
        "temperature_c": 125,
        "supply_v": {
          "Vdd": 1.08
        }
      }
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "5p 25.000n"
  },
  "measurements": [
    {
      "name": "t_ref",
      "crossings": {
        "signal": "v(ref)",
        "level": {
          "frac_of": "Vdd",
          "fraction": 0.5
        },
        "edge": "rise",
        "max": 1000
      }
    },
    {
      "name": "t_fb",
      "crossings": {
        "signal": "v(fb)",
        "level": {
          "frac_of": "Vdd",
          "fraction": 0.5
        },
        "edge": "rise",
        "max": 1000
      }
    },
    {
      "name": "t_up",
      "crossings": {
        "signal": "v(up)",
        "level": {
          "frac_of": "Vdd",
          "fraction": 0.5
        },
        "edge": "either",
        "max": 1000
      }
    },
    {
      "name": "t_dn",
      "crossings": {
        "signal": "v(dn)",
        "level": {
          "frac_of": "Vdd",
          "fraction": 0.5
        },
        "edge": "either",
        "max": 1000
      }
    },
    {
      "name": "t_set_up",
      "crossings": {
        "signal": "v(xdut.set_up)",
        "level": {
          "frac_of": "Vdd",
          "fraction": 0.5
        },
        "edge": "either",
        "max": 1000
      }
    },
    {
      "name": "t_set_dn",
      "crossings": {
        "signal": "v(xdut.set_dn)",
        "level": {
          "frac_of": "Vdd",
          "fraction": 0.5
        },
        "edge": "either",
        "max": 1000
      }
    },
    {
      "name": "t_reset",
      "crossings": {
        "signal": "v(xdut.reset)",
        "level": {
          "frac_of": "Vdd",
          "fraction": 0.5
        },
        "edge": "either",
        "max": 1000
      }
    },
    {
      "name": "t_up_qn",
      "crossings": {
        "signal": "v(xdut.up_qn)",
        "level": {
          "frac_of": "Vdd",
          "fraction": 0.5
        },
        "edge": "either",
        "max": 1000
      }
    },
    {
      "name": "t_up_qb",
      "crossings": {
        "signal": "v(xdut.up_qb)",
        "level": {
          "frac_of": "Vdd",
          "fraction": 0.5
        },
        "edge": "either",
        "max": 1000
      }
    },
    {
      "name": "t_dn_qn",
      "crossings": {
        "signal": "v(xdut.dn_qn)",
        "level": {
          "frac_of": "Vdd",
          "fraction": 0.5
        },
        "edge": "either",
        "max": 1000
      }
    },
    {
      "name": "t_dn_qb",
      "crossings": {
        "signal": "v(xdut.dn_qb)",
        "level": {
          "frac_of": "Vdd",
          "fraction": 0.5
        },
        "edge": "either",
        "max": 1000
      }
    }
  ],
  "options": {
    "osdi_preload": [
      "/home/ubuntu/share/pdk/ihp-sg13g2/libs.tech/ngspice/osdi/psp103.osdi",
      "/home/ubuntu/share/pdk/ihp-sg13g2/libs.tech/ngspice/osdi/psp103_nqs.osdi",
      "/home/ubuntu/share/pdk/ihp-sg13g2/libs.tech/ngspice/osdi/r3_cmc.osdi",
      "/home/ubuntu/share/pdk/ihp-sg13g2/libs.tech/ngspice/osdi/mosvar.osdi"
    ],
    "stage_model_inputs": true,
    "keep_artifacts": true
  }
