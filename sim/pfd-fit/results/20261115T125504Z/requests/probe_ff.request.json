{
  "_comment": [
    "sg13g2-dll sim/pfd-fit probe (probe_ff): single-corner diagnostic for issue #136.",
    "Same deck stimulus as pfd_1g at ff/1.32 V/-40 C, PFD-internal nodes probed, to check the",
    "C1-at-ff margin (reset must arrive after the set pulse ends) and C2 floor (width >= 30 ps).",
    "Run locally through `klt sim` (single unit, --backend local). Simulated, never measured."
  ],
  "engine": "ngspice",
  "netlist": "../decks/probe_ss.spice",
  "netlist_source": "schematic",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerMOSlv.lib"
  },
  "corners": {
    "units": [
      {
        "process": "mos_ff",
        "temperature_c": -40,
        "supply_v": {
          "Vdd": 1.32
        }
      }
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "5p 25.000n"
  },
  "measurements": [
    {
      "name": "t_ref",
      "crossings": {
        "signal": "v(ref)",
        "level": {
          "frac_of": "Vdd",
          "fraction": 0.5
        },
        "edge": "rise",
        "max": 1000
      }
    },
    {
      "name": "t_fb",
      "crossings": {
        "signal": "v(fb)",
        "level": {
          "frac_of": "Vdd",
          "fraction": 0.5
        },
        "edge": "rise",
        "max": 1000
      }
    },
    {
      "name": "t_up",
      "crossings": {
        "signal": "v(up)",
        "level": {
          "frac_of": "Vdd",
          "fraction": 0.5
        },
        "edge": "either",
        "max": 1000
      }
    },
    {
      "name": "t_dn",
      "crossings": {
        "signal": "v(dn)",
        "level": {
          "frac_of": "Vdd",
          "fraction": 0.5
        },
        "edge": "either",
        "max": 1000
      }
    },
    {
      "name": "t_set_up",
      "crossings": {
        "signal": "v(xdut.set_up)",
        "level": {
          "frac_of": "Vdd",
          "fraction": 0.5
        },
        "edge": "either",
        "max": 1000
      }
    },
    {
      "name": "t_set_dn",
      "crossings": {
        "signal": "v(xdut.set_dn)",
        "level": {
          "frac_of": "Vdd",
          "fraction": 0.5
        },
        "edge": "either",
        "max": 1000
      }
    },
    {
      "name": "t_reset",
      "crossings": {
        "signal": "v(xdut.reset)",
        "level": {
          "frac_of": "Vdd",
          "fraction": 0.5
        },
        "edge": "either",
        "max": 1000
      }
    }
  ],
  "options": {
    "osdi_preload": [
      "/home/ubuntu/share/pdk/ihp-sg13g2/libs.tech/ngspice/osdi/psp103.osdi",
      "/home/ubuntu/share/pdk/ihp-sg13g2/libs.tech/ngspice/osdi/psp103_nqs.osdi",
      "/home/ubuntu/share/pdk/ihp-sg13g2/libs.tech/ngspice/osdi/r3_cmc.osdi",
      "/home/ubuntu/share/pdk/ihp-sg13g2/libs.tech/ngspice/osdi/mosvar.osdi"
    ],
    "stage_model_inputs": true,
    "keep_artifacts": true
  }
}