{
  "_comment": [
    "sg13g2-dll 0006 PFD fit gate (pfd_500m). Generated by sim/pfd-fit/make_bench.py.",
    "Corners: the three-corner reduced_set of sim/corners.json (spec/decisions/0001: fast iteration only).",
    "Results are simulated, never measured. /home/ubuntu/share/pdk/ihp-sg13g2/libs.tech/ngspice/osdi is substituted by run.sh."
  ],
  "engine": "ngspice",
  "netlist": "../decks/pfd_500m.spice",
  "netlist_source": "schematic",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerMOSlv.lib"
  },
  "corners": {
    "units": [
      {
        "process": "mos_tt",
        "temperature_c": 27,
        "supply_v": {
          "Vdd": 1.2
        }
      },
      {
        "process": "mos_ss",
        "temperature_c": 125,
        "supply_v": {
          "Vdd": 1.08
        }
      },
      {
        "process": "mos_ff",
        "temperature_c": -40,
        "supply_v": {
          "Vdd": 1.32
        }
      }
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "5p 45.000n"
  },
  "measurements": [
    {
      "name": "t_ref",
      "crossings": {
        "signal": "v(ref)",
        "level": {
          "frac_of": "Vdd",
          "fraction": 0.5
        },
        "edge": "rise",
        "max": 1000
      }
    },
    {
      "name": "t_fb",
      "crossings": {
        "signal": "v(fb)",
        "level": {
          "frac_of": "Vdd",
          "fraction": 0.5
        },
        "edge": "rise",
        "max": 1000
      }
    },
    {
      "name": "t_up",
      "crossings": {
        "signal": "v(up)",
        "level": {
          "frac_of": "Vdd",
          "fraction": 0.5
        },
        "edge": "either",
        "max": 1000
      }
    },
    {
      "name": "t_dn",
      "crossings": {
        "signal": "v(dn)",
        "level": {
          "frac_of": "Vdd",
          "fraction": 0.5
        },
        "edge": "either",
        "max": 1000
      }
    }
  ],
  "options": {
    "osdi_preload": [
      "/home/ubuntu/share/pdk/ihp-sg13g2/libs.tech/ngspice/osdi/psp103.osdi",
      "/home/ubuntu/share/pdk/ihp-sg13g2/libs.tech/ngspice/osdi/psp103_nqs.osdi",
      "/home/ubuntu/share/pdk/ihp-sg13g2/libs.tech/ngspice/osdi/r3_cmc.osdi",
      "/home/ubuntu/share/pdk/ihp-sg13g2/libs.tech/ngspice/osdi/mosvar.osdi"
    ],
    "stage_model_inputs": true,
    "keep_artifacts": true
  }
}
