{
  "_comment": [
    "sg13g2-dll noise-method: slew rate at the OP, noiseless (0014).",
    "SR = 0.1 V / (t55 - t65) on a falling output edge; deterministic."
  ],
  "engine": "ngspice",
  "netlist": "../decks/nm_sr.spice",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerMOSlv.lib"
  },
  "corners": {
    "process": ["mos_tt"],
    "temperature_c": [27]
  },
  "analysis": {
    "kind": "tran",
    "args": "1p 10n"
  },
  "measurements": [
    {
      "name": "t65_2",
      "spice": ".meas tran t65_2 WHEN v(out)=0.65 FALL=2",
      "unit": "s"
    },
    {
      "name": "t55_2",
      "spice": ".meas tran t55_2 WHEN v(out)=0.55 FALL=2",
      "unit": "s"
    },
    {
      "name": "t65_3",
      "spice": ".meas tran t65_3 WHEN v(out)=0.65 FALL=3",
      "unit": "s"
    },
    {
      "name": "t55_3",
      "spice": ".meas tran t55_3 WHEN v(out)=0.55 FALL=3",
      "unit": "s"
    }
  ],
  "options": {
    "osdi_preload": [
      "/home/ubuntu/share/pdk/ihp-sg13g2/libs.tech/ngspice/osdi/psp103.osdi",
      "/home/ubuntu/share/pdk/ihp-sg13g2/libs.tech/ngspice/osdi/psp103_nqs.osdi",
      "/home/ubuntu/share/pdk/ihp-sg13g2/libs.tech/ngspice/osdi/r3_cmc.osdi",
      "/home/ubuntu/share/pdk/ihp-sg13g2/libs.tech/ngspice/osdi/mosvar.osdi"
    ],
    "stage_model_inputs": true
  }
}
