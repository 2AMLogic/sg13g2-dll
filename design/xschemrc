#### Project-local xschem configuration for sg13g2-dll (issue #23).
#### Same convention as sg13g2-pll's design/xschemrc: reset the library path,
#### resolve the SG13G2 PDK like `klt pdk find`, then add this repo's design/.
#### Load explicitly:  klt netlist --rcfile design/xschemrc ...

set XSCHEM_LIBRARY_PATH {}
append XSCHEM_LIBRARY_PATH :${XSCHEM_SHAREDIR}/xschem_library/devices

if {[info exists env(PDK_ROOT)]} {
  set PDK_ROOT $env(PDK_ROOT)
}
if {[info exists env(PDK)]} {
  set PDK $env(PDK)
} else {
  set PDK ihp-sg13g2
}

if { ![info exists PDK_ROOT] || $PDK_ROOT eq {} } {
    foreach candidate [list /usr/share/pdk /usr/local/share/pdk \
                            [file join $env(HOME) share pdk] \
                            [file join $env(HOME) .ciel] \
                            [file join $env(HOME) .volare]] {
        if { [file isdir [file join $candidate $PDK libs.tech xschem]] } {
            set PDK_ROOT $candidate
            break
        }
    }
}

if { ![info exists PDK_ROOT] || $PDK_ROOT eq {} } {
    puts stderr "xschemrc: no $PDK install found under PDK_ROOT or the usual prefixes."
} else {
    set env(PDK_ROOT) $PDK_ROOT
    set env(PDK) $PDK
    set pdk_xschemrc [file join $PDK_ROOT $PDK libs.tech xschem xschemrc]
    if { [file exists $pdk_xschemrc] } {
        source $pdk_xschemrc
    } else {
        puts stderr "xschemrc: $pdk_xschemrc not found; $PDK symbols unavailable."
    }
}

#### Re-assert the generic devices library and add this repo's design/ last, so
#### a bare reference (delay_cell.sym) resolves to this repo's own symbol.
set REPO_ROOT [file dirname [file dirname [file normalize [info script]]]]
if { ![info exists XSCHEM_LIBRARY_PATH] } { set XSCHEM_LIBRARY_PATH {} }
append XSCHEM_LIBRARY_PATH :${XSCHEM_SHAREDIR}/xschem_library/devices
append XSCHEM_LIBRARY_PATH :[file join $REPO_ROOT design]

set XSCHEM_START_WINDOW {}
